<div class="text-bg-primary p-3 d-flex justify-content-center"><h1>Stupid Coaching</h1></div>

<div class="text-bg-light p-3 d-flex justify-content-center">
  <i class="fa-solid fa-walkie-talkie"></i>
  <%= params["question"]%>
  <p>  --You</p>
</div>
<div class="text-bg-dark p-3 d-flex justify-content-center">
  <i class="fa-solid fa-walkie-talkie"></i>
  <%= @answer %>
  <p>  --Coach</p>
</div>

<div class="d-flex justify-content-center">
  <%= link_to ask_path do %>
  <i class="fa-solid fa-circle-question"></i>
  Consult Again
  <% end %></div>
